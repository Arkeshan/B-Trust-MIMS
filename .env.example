# Database Configuration
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=btrust

# Admin Initial Credentials (used on initial boot to seed the admin account)
ADMIN_EMAIL=arkesuje@gmail.com
ADMIN_INITIAL_PASSWORD=change_this_password_in_production

# Cookie Security (set to true in production over HTTPS)
COOKIE_SECURE=false

# Environment mode (development or production)
ENV=development

# SMTP Configuration for Email OTP (optional for dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=noreply@btrust.lk

